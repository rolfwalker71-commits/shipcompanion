PORT=3344
API_PORT=3345
APP_ACCESS_KEY=change-me
AISSTREAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
COOKIE_SECURE=false
# Lokal HTTP: false lassen. Hinter HTTPS-Reverse-Proxy:
# COOKIE_SECURE=true  — oder Proxy X-Forwarded-Proto=https schicken.
# APP_ACCESS_KEY ist der Login; Docker liest die Server-.env (nicht die lokale).
# optional paid AIS (terrestrial + satellite) when coastal AIS is quiet
# DATADOCKED_API_KEY=
# DATADOCKED_MIN_INTERVAL_HOURS=3
# DATADOCKED_MONTHLY_LIMIT=250
# PIN to switch Data Docked to hourly (transatlantic). Not the family login key.
# SETTINGS_PIN=
# optional contact for Web Push (mailto:… or https://…)
# VAPID_MAILTO=mailto:family@localhost
